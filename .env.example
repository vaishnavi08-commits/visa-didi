# Claude API key. Without it, Visa Didi runs in "official text" mode and quotes the official pages directly.
ANTHROPIC_API_KEY=
# Claude model. Default claude-sonnet-5-5. claude-haiku-4-5 is cheaper but misreads nuanced rules; claude-opus-5-5 is most careful.
CLAUDE_MODEL=
# Hard caps on Claude API spend, in USD (defaults: $0.50 a day, $5 a month).
DAILY_BUDGET_USD=0.5
MONTHLY_BUDGET_USD=5
# Optional: protects the weekly re-check endpoint.
CRON_SECRET=
# Optional: speak answers in your own cloned voice (ElevenLabs). Without these, the browser's voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Supabase: stores official pages, the answer cache, rate limits, spend and the question log.
# Without these, the app uses data/store.json and in-memory state.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
