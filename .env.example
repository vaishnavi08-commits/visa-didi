# Claude API key. Without it, Visa Didi runs in "official text" mode and quotes the official pages directly.
ANTHROPIC_API_KEY=
# Monthly spending cap for the Claude API, in USD.
MONTHLY_BUDGET_USD=20
# Optional: protects the weekly re-check endpoint.
CRON_SECRET=
# Optional: speak answers in your own cloned voice (ElevenLabs). Without these, the browser's voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
